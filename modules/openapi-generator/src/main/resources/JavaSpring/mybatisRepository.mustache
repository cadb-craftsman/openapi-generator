<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amaseguros.restservice.repository.RestServiceRepository">
	
	<select id="findById" resultType="com.amaseguros.restservice.domain.model.persistence.RestServiceEntity">
		SELECT id, name, description FROM PRODUCT WHERE id = #{id}
	</select>

	<select id="findAll" resultType="com.amaseguros.restservice.domain.model.persistence.RestServiceEntity">
		SELECT  id, name, description FROM PRODUCT
	</select>
	
	<select id="findByPage" resultType="com.amaseguros.restservice.domain.model.persistence.RestServiceEntity">
		SELECT id, name, description FROM PRODUCT
	</select>

	<insert id="save" keyColumn="id" keyProperty="id"
		parameterType="com.amaseguros.restservice.domain.model.persistence.RestServiceEntity"
		useGeneratedKeys="true"> INSERT INTO PRODUCT 
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null and id != '' ">
				id,
			</if>
			<if test="name != null">
				name,
			</if>
			<if test="description != null and description != '' ">
				description,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null and id != '' ">
				#{id},
			</if>
			<if test="name != null">
				#{name},
			</if>
			<if test="description != null and description != '' ">
				#{description},
			</if>
		</trim>
	</insert>

	<update id="update"
		parameterType="com.amaseguros.restservice.domain.model.persistence.RestServiceEntity">
		UPDATE PRODUCT 
		<set>
			name = #{name},
			description = #{description}
		</set> WHERE id = #{id} 
	</update>

	<delete id="delete">
		DELETE FROM PRODUCT
		WHERE id = #{id}
	</delete>

</mapper>